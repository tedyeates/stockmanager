container_commands:
  01_migrate:
    command: "django-admin.py migrate"
    leader_only: true
  02_createsu:
    command: "django-admin.py createsu"
    leader_only: true
  03_collectstatic:
    command: "django-admin.py collectstatic --noinput"


option_settings:
  aws:elasticbeanstalk:application:environment:
    DJANGO_SETTINGS_MODULE: "ted_site.settings"
  aws:elasticbeanstalk:container:python:
    WSGIPath: ted_site.wsgi:application
packages:
  yum:
    postgresql93-devel: []